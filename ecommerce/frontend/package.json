{
  "name": "pangchong-ecommerce-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "design:tokens": "node scripts/build-design-tokens.mjs",
    "design:tokens:check": "node scripts/build-design-tokens.mjs --check",
    "design:figma": "node scripts/build-figma-handoff.mjs",
    "design:figma:check": "node scripts/build-figma-handoff.mjs --check",
    "design:lint": "node scripts/check-design-system.mjs",
    "copy:extract": "node scripts/ui-copy.mjs extract",
    "copy:check": "node scripts/ui-copy.mjs check",
    "copy:apply": "node scripts/ui-copy.mjs apply --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:diy-mobile": "playwright test e2e/diy-mobile.visual.spec.js",
    "test:e2e:startup": "playwright test e2e/startup-session.spec.js",
    "test:e2e:diy-mobile:update": "playwright test e2e/diy-mobile.visual.spec.js --update-snapshots",
    "perf:startup": "node scripts/measure-startup.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.2",
    "axios": "^1.6.5",
    "pinia": "^2.1.7",
    "reka-ui": "^2.10.4",
    "three": "^0.184.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vite": "^5.0.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.2"
  }
}
