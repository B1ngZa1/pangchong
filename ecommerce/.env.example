# ============================================
# 胖虫电商 — 环境变量配置模板
# 复制此文件为 .env 并修改实际值
# 切勿将 .env 提交到版本控制
# ============================================

# 数据库
POSTGRES_DB=pangchong_ecommerce
POSTGRES_USER=pangchong
POSTGRES_PASSWORD=pangchong_dev_password

# Redis
REDIS_PASSWORD=pangchong_dev_redis

# JWT 密钥 (生成方式: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-local-dev-secret

# 调试模式 (生产环境设为 false)
DEBUG=true

# CORS 允许的来源
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost","http://localhost:80"]

# 支付宝（可选）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true

# 邮件（可选）
SMTP_USER=
SMTP_PASSWORD=
