# ============================================
# 胖虫电商 - Docker Compose 环境变量模板
# ============================================
#
# 新克隆项目后不需要复制本文件；docker-compose.yml 已经
# 为本地开发提供默认值。
#
# 只有在需要修改数据库密码、Redis 密码、JWT 密钥、CORS
# 来源或第三方服务配置时，才复制本文件为 .env：
#
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Docker Compose 会自动读取 ecommerce/.env。
# 请勿将 .env 提交到版本控制。

# PostgreSQL
POSTGRES_DB=pangchong_ecommerce
POSTGRES_USER=pangchong
POSTGRES_PASSWORD=pangchong_dev_password

# 本地 docker-compose.yml 始终使用内置 PostgreSQL，不读取 DATABASE_URL。
# 仅在手动运行后端或使用 docker-compose.prod.yml 时取消下一行注释：
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler>:5432/postgres?ssl=require

# Redis
REDIS_PASSWORD=pangchong_dev_redis

# JWT 密钥
# 生成方式：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-local-dev-secret

# 调试模式
DEBUG=true

# CORS 允许来源
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost","http://localhost:80"]

# 支付宝沙箱，可留空
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true

# 邮件服务，可留空
SMTP_USER=
SMTP_PASSWORD=

# 资产存储默认使用 backend/uploads；仅部署时显式改为 supabase。
ASSET_STORAGE_BACKEND=local

# Supabase Storage（仅后端读取，禁止使用 VITE_ 前缀）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=catalog-images
SUPABASE_MODEL_BUCKET=catalog-models

# 20 MB GLB + multipart 封装空间
MAX_REQUEST_SIZE=23068672
