# Production template for docker-compose.prod.yml. Never commit the populated file.
# Generate independent values; do not reuse database, Redis, JWT, or payment secrets.
# Database and Redis passwords must be 16+ characters with at least 6 distinct characters.
POSTGRES_DB=pangchong_ecommerce
POSTGRES_USER=pangchong
POSTGRES_PASSWORD=replace-me-with-a-random-database-password
REDIS_PASSWORD=replace-me-with-a-random-redis-password

# SECRET_KEY must be 32+ characters with at least 8 distinct characters.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-random-hex-characters
DEBUG=false
RELOAD=false
WEB_CONCURRENCY=2
# Browser refresh sessions are HttpOnly and must only travel over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Production origins must be explicit HTTPS origins; wildcard/local HTTP is rejected.
ALLOWED_ORIGINS=["https://shop.example.com"]

ALIPAY_APP_ID=replace-me-with-the-production-app-id
ALIPAY_PRIVATE_KEY=replace-me-with-the-production-private-key
ALIPAY_PUBLIC_KEY=replace-me-with-the-production-alipay-public-key
ALIPAY_SANDBOX=false
ALIPAY_NOTIFY_URL=https://shop.example.com/api/payment/callback/alipay
ALIPAY_RETURN_URL=https://shop.example.com/checkout/success
ALIPAY_SELLER_ID=replace-me-with-the-production-seller-id

SMTP_USER=
SMTP_PASSWORD=
ASSET_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=catalog-images
SUPABASE_MODEL_BUCKET=catalog-models
MAX_REQUEST_SIZE=23068672
